# Copy these into the Railway API service Variables UI (or `railway variable set`).
# Do not commit real values.

# Railway injects PORT; hazara-server binds 0.0.0.0:$PORT when HAZARA_BIND is unset.
# PORT=8080

# Railway Postgres plugin reference, e.g. ${{Postgres.DATABASE_URL}}
# Unset keeps the file store under HAZARA_STATE.
DATABASE_URL=

# SQL files copied into the image at /srv/migrations
# HAZARA_MIGRATIONS_DIR=/srv/migrations

# File store directory when DATABASE_URL is unset (volume mount at /data)
HAZARA_STATE=/data

# Comma-separated Firebase Hosting origins (no trailing slash).
# Also accepted as ALLOWED_ORIGINS (Judgement convention).
# Example: https://hazara-lws-260731.web.app,https://hazara-lws-260731.firebaseapp.com
HAZARA_CORS_ORIGIN=
ALLOWED_ORIGINS=

# Primary web origin for invite / WhatsApp share links (Firebase URL)
PUBLIC_WEB_ORIGIN=

RUST_LOG=info
